<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Siv3D (SDL3 版) iOS アプリの Info.plist のテンプレート (cmake/Siv3DAppTarget.cmake が siv3d-app.json の "ios" 節から生成する) -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@SIV3D_IOS_EXECUTABLE@</string>
	<key>CFBundleIdentifier</key>
	<string>@SIV3D_IOS_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@SIV3D_IOS_DISPLAY_NAME@</string>
	<key>CFBundleDisplayName</key>
	<string>@SIV3D_IOS_DISPLAY_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SIV3D_IOS_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@SIV3D_IOS_BUILD@</string>
	<key>MinimumOSVersion</key>
	<string>@SIV3D_IOS_DEPLOYMENT_TARGET@</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
@SIV3D_IOS_ORIENTATIONS_PLIST@	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
@SIV3D_IOS_ORIENTATIONS_PLIST@	</array>
</dict>
</plist>
