{
  "name": "opensiv3d",
  "version-string": "0.6.16",
  "dependencies": [
    "boost-algorithm",
    "boost-asio",
    "boost-container",
    "boost-date-time",
    "boost-exception",
    "boost-filesystem",
    "boost-geometry",
    "boost-interprocess",
    "boost-iostreams",
    "boost-json",
    "boost-phoenix",
    "boost-predef",
    "boost-range",
    "boost-smart-ptr",
    "boost-system",
    "boost-uuid",
    {
      "name": "curl",
      "platform": "!emscripten"
    },
    "freetype",
    "giflib",
    {
      "name": "harfbuzz",
      "platform": "!emscripten & !android"
    },
    "libjpeg-turbo",
    "libpng",
    "libwebp",
    {
      "name": "opencv4",
      "features": [
        "jpeg",
        "png",
        "webp",
        "tiff",
        "quirc",
        "thread"
      ],
      "platform": "!linux & !emscripten & !android"
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "jpeg",
        "png",
        "webp",
        "tiff",
        "quirc",
        "thread"
      ],
      "platform": "linux | android"
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "jpeg",
        "png",
        "webp",
        "quirc"
      ],
      "platform": "emscripten"
    },
    {
      "name": "opengl",
      "platform": "!emscripten & !android"
    },
    "opus",
    "opusfile",
    "tiff",
    "stduuid",
    "libvorbis",
    "zlib",
    "zstd",
    "minizip",
    {
      "name": "angle",
      "features": [
        "metal"
      ],
      "platform": "osx"
    }
  ],
  "features": {
    "ffmpeg": {
      "description": "Linux: VideoReader / VideoTexture で MP4 などを開くために opencv4 に FFmpeg (LGPL、共有ライブラリで同梱) を組み込む",
      "dependencies": [
        {
          "name": "opencv4",
          "default-features": false,
          "features": [
            "ffmpeg"
          ],
          "platform": "linux"
        },
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample",
            "swscale"
          ],
          "platform": "linux"
        }
      ]
    },
    "movieplayer": {
      "description": "WebM (VP8 / VP9 + Vorbis / Opus) を movie-player で再生する",
      "dependencies": [
        "libvpx",
        "libogg",
        {
          "name": "libyuv",
          "platform": "!windows"
        }
      ]
    }
  },
  "builtin-baseline": "bc38a15b0bee8bc48a49ea267cc32fbb49aedfc4"
}
