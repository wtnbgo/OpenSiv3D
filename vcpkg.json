{
  "name": "opensiv3d",
  "version-string": "0.6.16",  
  "dependencies": [
    "boost-algorithm",
    "boost-asio",
    "boost-container",
    "boost-date-time",
    "boost-exception",
    "boost-filesystem",
    "boost-geometry",
    "boost-interprocess",
    "boost-iostreams",
    "boost-json",
    "boost-phoenix",
    "boost-predef",
    "boost-range",
    "boost-smart-ptr",
    "boost-system",
    "boost-uuid",
    "curl",
    "freetype",
    "giflib",
    "harfbuzz",
    "libjpeg-turbo",
    "libpng",
    "libwebp",
    {
      "name": "opencv4",
      "features": [
        "jpeg",
        "png",
        "webp",
        "tiff",
        "quirc",
        "thread"
      ],
      "platform": "!linux"
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "jpeg",
        "png",
        "webp",
        "tiff",
        "quirc",
        "thread",
        "ffmpeg"
      ],
      "platform": "linux"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ],
      "platform": "linux"
    },
    "opengl",
    "opus",
    "opusfile",
    "tiff",
    "stduuid",
    "libvorbis",
    "zlib",
    "zstd",
    "minizip",
    {
      "name": "angle",
      "features": [
        "metal"
      ],
      "platform": "osx"
    }
  ],
  "builtin-baseline": "bc38a15b0bee8bc48a49ea267cc32fbb49aedfc4"
}
